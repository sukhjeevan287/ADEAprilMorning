{
	"name": "flowlet1",
	"properties": {
		"type": "Flowlet",
		"typeProperties": {
			"sources": [],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "input1"
				},
				{
					"name": "output1"
				}
			],
			"scriptLines": [
				"input(output(",
				"          CustomerID as integer,",
				"          FirstName as string,",
				"          MiddleName as string,",
				"          LastName as string",
				"     ),",
				"     order: 0,",
				"     allowSchemaDrift: true) ~> input1",
				"input1 derive(FullName = concat(FirstName, ' ',MiddleName,' ',LastName)) ~> derivedColumn1",
				"derivedColumn1 output() ~> output1"
			]
		}
	}
}