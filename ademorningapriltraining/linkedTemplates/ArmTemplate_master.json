{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ademorningapriltraining"
		},
		"LS_ADLS_AprilADE_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_AprilADE'"
		},
		"LS_DatabaseConn_Adventureworks_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_DatabaseConn_Adventureworks'"
		},
		"LS_OnPrem_AdventureWorks_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_OnPrem_AdventureWorks'"
		},
		"LS_SQLServer_OnPrem_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLServer_OnPrem'"
		},
		"DS_Source_Rest_JSON_Data_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://jsonplaceholder.typicode.com/"
		},
		"LS_ADLS_AprilADE_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://morningaprilbatchade.dfs.core.windows.net/"
		},
		"LS_DatabaseConn_Adventureworks_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "trainingdbdev.database.windows.net"
		},
		"LS_DatabaseConn_Adventureworks_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "adventureworks"
		},
		"LS_DatabaseConn_Adventureworks_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dbadmin"
		},
		"LS_OnPrem_AdventureWorks_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "DESKTOP-SEDK2UR\\MSSQLSERVER01"
		},
		"LS_OnPrem_AdventureWorks_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksLT2019"
		},
		"LS_OnPrem_AdventureWorks_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dbadmin"
		},
		"LS_SQLServer_OnPrem_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "DESKTOP-SEDK2UR\\MSSQLSERVER01"
		},
		"LS_SQLServer_OnPrem_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksLT2019"
		},
		"LS_SQLServer_OnPrem_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dbadminevn"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ademorningapriltraining_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_AprilADE_accountKey": {
						"value": "[parameters('LS_ADLS_AprilADE_accountKey')]"
					},
					"LS_DatabaseConn_Adventureworks_password": {
						"value": "[parameters('LS_DatabaseConn_Adventureworks_password')]"
					},
					"DS_Source_Rest_JSON_Data_properties_typeProperties_url": {
						"value": "[parameters('DS_Source_Rest_JSON_Data_properties_typeProperties_url')]"
					},
					"LS_ADLS_AprilADE_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_AprilADE_properties_typeProperties_url')]"
					},
					"LS_DatabaseConn_Adventureworks_properties_typeProperties_server": {
						"value": "[parameters('LS_DatabaseConn_Adventureworks_properties_typeProperties_server')]"
					},
					"LS_DatabaseConn_Adventureworks_properties_typeProperties_database": {
						"value": "[parameters('LS_DatabaseConn_Adventureworks_properties_typeProperties_database')]"
					},
					"LS_DatabaseConn_Adventureworks_properties_typeProperties_userName": {
						"value": "[parameters('LS_DatabaseConn_Adventureworks_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "ademorningapriltraining_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_OnPrem_AdventureWorks_password": {
						"value": "[parameters('LS_OnPrem_AdventureWorks_password')]"
					},
					"LS_SQLServer_OnPrem_password": {
						"value": "[parameters('LS_SQLServer_OnPrem_password')]"
					},
					"LS_OnPrem_AdventureWorks_properties_typeProperties_server": {
						"value": "[parameters('LS_OnPrem_AdventureWorks_properties_typeProperties_server')]"
					},
					"LS_OnPrem_AdventureWorks_properties_typeProperties_database": {
						"value": "[parameters('LS_OnPrem_AdventureWorks_properties_typeProperties_database')]"
					},
					"LS_OnPrem_AdventureWorks_properties_typeProperties_userName": {
						"value": "[parameters('LS_OnPrem_AdventureWorks_properties_typeProperties_userName')]"
					},
					"LS_SQLServer_OnPrem_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLServer_OnPrem_properties_typeProperties_server')]"
					},
					"LS_SQLServer_OnPrem_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLServer_OnPrem_properties_typeProperties_database')]"
					},
					"LS_SQLServer_OnPrem_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQLServer_OnPrem_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'ademorningapriltraining_ArmTemplate_0')]"
			]
		},
		{
			"name": "ademorningapriltraining_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'ademorningapriltraining_ArmTemplate_1')]"
			]
		}
	]
}